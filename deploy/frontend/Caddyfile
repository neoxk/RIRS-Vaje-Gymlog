{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode gzip

	# URL backenda pride iz okoljske spremenljivke BACKEND_URL
	handle /api/* {
		reverse_proxy {$BACKEND_URL}
	}

	# SPA: neznane poti vrnejo index.html, da jih obdela React Router
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
